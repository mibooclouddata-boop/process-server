# Server only. Copy to .env.local (ignored); do not paste actual values into chat.
# Local is the existing JSON authentication; Supabase is an explicit opt-in.
AUTH_PROVIDER=local
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 32 random bytes encoded as 64 hex characters. Generate in a secret manager.
SESSION_ENCRYPTION_KEY=
# true behind production HTTPS; false only for local HTTP testing.
SESSION_COOKIE_SECURE=false
# Use a NEW EMPTY test directory, never the production data directory.
PROCESS_DATA_DIR=./.local-supabase-test-data
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=
